<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="?attr/dialogPreferredPadding"
    android:paddingTop="18dp">

    <EditText
        android:id="@+id/webdav_auto_backup_hours"
        style="@style/FixedLineHeightEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_webdav_auto_backup_hours_hint"
        android:inputType="number"
        android:singleLine="true" />

    <TextView
        android:id="@+id/webdav_auto_backup_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:text="@string/settings_webdav_auto_backup_test"
        android:textColor="?attr/colorPrimary" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="?attr/dialogPreferredPadding"
    android:paddingTop="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_webdav_config_payload_hint"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/text_little_small" />

    <EditText
        android:id="@+id/webdav_config_payload"
        style="@style/FixedLineHeightEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="8"
        android:minLines="3" />

    <TextView
        android:id="@+id/webdav_config_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:text="@string/settings_webdav_config_copy"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/webdav_config_paste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:text="@string/settings_webdav_config_paste"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />
</LinearLayout>
